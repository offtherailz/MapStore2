# MapStore2 E2E environment variables
# Copy this file to .env, .env.local, .env.qa, .env.customer-acme, ...
# The profile is selected with E2E_ENV=<name> or E2E_ENV_FILE=<path>.

# Base URL of the MapStore2 instance under test.
# Local dev example:    http://localhost:8081/
# Server example:       https://my-server.example/mapstore/
# Customer example:     https://customer.example/sit/mapstore/
# It may include a base path such as /mapstore/ or another customer-specific path.
BASE_URL=http://localhost:8081/

# Admin credentials
MS_USER=admin
MS_PASSWORD=admin

# Optional regular user credentials for permission checks
MS_USER_STANDARD=
MS_PASSWORD_STANDARD=

# Optional features, comma separated
# Example: E2E_FEATURES=oidc,ldap,geoserverIntegration
E2E_FEATURES=

# Optional service endpoints as JSON
# Example: E2E_SERVICES_JSON={"geoserver":"https://example.com/geoserver","print":"https://example.com/print"}
E2E_SERVICES_JSON={}

# Optional environment-specific resources as JSON
# Example: E2E_RESOURCES_JSON={"demoMap":"#/viewer/1","catalogContext":"#/context/catalog"}
E2E_RESOURCES_JSON={}
